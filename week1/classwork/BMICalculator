
import java.util.Scanner;

public class BMICalculator {

    // Method to classify BMI
    static String getBmiStatus(double bmi) {

        if (bmi < 18.5) {
            return "Underweight";
        } else if (bmi < 25) {
            return "Normal";
        } else if (bmi < 30) {
            return "Overweight";
        } else {
            return "Obese";
        }
    }

    // Method to display wellness report
    static void printWellnessReport(double[] heights, double[] weights) {

        System.out.println("\nWELLNESS REPORT");
        System.out.println("-----------------------------------------------");
        System.out.printf("%-10s %-12s %-12s %-10s %-15s\n",
                "Person", "Height", "Weight", "BMI", "Status");

        for (int i = 0; i < heights.length; i++) {

            double bmi = weights[i] / (heights[i] * heights[i]);

            System.out.printf("%-10d %-12.2f %-12.2f %-10.2f %-15s\n",
                    i + 1, heights[i], weights[i],
                    bmi, getBmiStatus(bmi));
        }

        System.out.println("-----------------------------------------------");
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of people: ");
        int n = sc.nextInt();

        if (n <= 0) {
            System.out.println("Invalid number of people.");
            sc.close();
            return;
        }

        double[] heights = new double[n];
        double[] weights = new double[n];

        for (int i = 0; i < n; i++) {

            System.out.print("Enter height of person " + (i + 1) + " (meters): ");
            heights[i] = sc.nextDouble();

            System.out.print("Enter weight of person " + (i + 1) + " (kg): ");
            weights[i] = sc.nextDouble();

            if (heights[i] <= 0 || weights[i] <= 0) {
                System.out.println("Height and weight must be positive.");
                sc.close();
                return;
            }
        }

        printWellnessReport(heights, weights);

        sc.close();
    }
}
